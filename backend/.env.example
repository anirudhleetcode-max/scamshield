# Copy to .env and adjust. Never commit .env.

# development | test | production. In production the app refuses to start with a weak JWT_SECRET.
ENV=development

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=scamshield

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to get an ephemeral random secret (sessions reset on restart).
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model artifact: models/scamshield-<MODEL_VERSION>.joblib + .card.json
MODEL_VERSION=2.0.0
# MODEL_DIR=/absolute/path/to/models
INFERENCE_TIMEOUT_S=10

# Failed logins allowed per (IP, email) within the window
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_S=300

MAX_BODY_BYTES=64000
LOG_LEVEL=INFO
