{
  "name": "syn2real",
  "description": "Track A - train and tune on SYNTHETIC data only, test on held-out synthetic templates and on REAL data (cross-domain).",
  "train": [
    {
      "dataset": "synthetic_in",
      "splits": [
        "train"
      ]
    }
  ],
  "val": [
    {
      "dataset": "synthetic_in",
      "splits": [
        "val"
      ]
    }
  ],
  "category_head": true,
  "seed": 42,
  "features": {
    "word_max_features": 12000,
    "char_max_features": 20000,
    "word_min_df": 2,
    "char_min_df": 3,
    "sublinear_tf": true
  },
  "model_params": {
    "C": 4.0,
    "svc_C": 0.5,
    "alpha": 0.1,
    "category_C": 8.0
  },
  "models": [
    "majority",
    "rules_only",
    "nb",
    "logreg_noweight",
    "logreg_uncal",
    "logreg_cal",
    "linsvc_cal"
  ],
  "main_model": "logreg_cal",
  "threshold": {
    "strategy": "max_f1"
  },
  "operating_points": {
    "suspicious_min_recall": 0.95,
    "scam_min_precision": 0.97,
    "selective_target_accuracy": 0.98
  },
  "test_sets": {
    "synthetic_test": [
      {
        "dataset": "synthetic_in",
        "splits": [
          "test"
        ]
      }
    ],
    "uci_test": [
      {
        "dataset": "uci_sms_spam",
        "splits": [
          "test"
        ]
      }
    ],
    "all_scam_spam_short": [
      {
        "dataset": "all_scam_spam_short",
        "splits": [
          "test"
        ]
      }
    ]
  },
  "error_analysis": {
    "test_sets": [
      "synthetic_test",
      "uci_test"
    ],
    "top_k": 25
  }
}
